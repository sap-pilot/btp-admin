{
  "name": "btp-admin-server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "PLAYWRIGHT_BROWSERS_PATH=./pw-browsers node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=./pw-browsers npx playwright install chromium",
    "test": "node --test dist/**/*.test.js 2>/dev/null || echo 'No tests'"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
